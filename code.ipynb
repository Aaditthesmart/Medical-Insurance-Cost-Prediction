# =========================
# 1. Imports
# =========================
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeRegressor
from sklearn.metrics import mean_absolute_error


# =========================
# 2. Load Data
# =========================
data = pd.read_csv("medical-charges.csv")


# =========================
# 3. Basic Data Inspection
# =========================
data.head(50)
data.shape
data.columns

data.isnull().sum()
data.describe()
data.info()


# =========================
# 4. Exploratory Data Analysis (EDA)
# =========================

# Smoking vs Charges
sns.barplot(
    x="smoker",
    y="charges",
    data=data,
    estimator="mean",
    errorbar=None
)
plt.title("Smoking vs Charges")
plt.show()

# BMI vs Charges
sns.scatterplot(
    x="bmi",
    y="charges",
    data=data
)
plt.title("BMI vs Charges")
plt.show()

# BMI Distribution
sns.histplot(
    data["bmi"],
    kde=True
)
plt.title("BMI Distribution")
plt.show()


# =========================
# 5. Feature & Target Selection
# =========================
y = data["charges"]

features = [
    "age",
    "sex",
    "bmi",
    "region",
    "smoker",
    "children"
]

X = data[features]


# =========================
# 6. Train–Validation Split
# =========================
train_X, val_X, train_y, val_y = train_test_split(
    X, y, random_state=1
)


# =========================
# 7. Encode Categorical Variables
# =========================
train_X = pd.get_dummies(train_X, drop_first=True)
val_X = pd.get_dummies(val_X, drop_first=True)

# Align validation columns with training columns
val_X = val_X.reindex(
    columns=train_X.columns,
    fill_value=0
)


# =========================
# 8. Model Training
# =========================
price_model = DecisionTreeRegressor(random_state=1)
price_model.fit(train_X, train_y)


# =========================
# 9. Validation Evaluation
# =========================
val_predictions = price_model.predict(val_X)
val_mae = mean_absolute_error(val_predictions, val_y)

print("Validation MAE:", val_mae)


# =========================
# 10. Training Evaluation (Overfitting Check)
# =========================
train_predictions = price_model.predict(train_X)
train_mae = mean_absolute_error(train_predictions, train_y)

print("Train MAE:", train_mae)
